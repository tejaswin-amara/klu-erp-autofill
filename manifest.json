{
  "manifest_version": 3,
  "name": "KLU ERP Captcha Auto-Fill",
  "version": "1.0.3",
  "description": "Uses a bundled model for local CAPTCHA recognition and autofill. Verify the result before submitting the ERP form.",
  "content_scripts": [
    {
      "matches": [
        "https://newerp.kluniversity.in/*"
      ],
      "js": [
        "lib/ort.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model/crnn.onnx",
        "model/crnn.json",
        "lib/ort-wasm-simd.wasm"
      ],
      "matches": [
        "https://newerp.kluniversity.in/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
